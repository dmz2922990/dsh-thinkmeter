{
  "name": "dsh-thinkmeter",
  "description": "DSH client plugin: replace the streaming Think reasoning preview with a live token-count display.",
  "version": "0.2.2",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "src/index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "thinking",
    "tokens"
  ],
  "license": "MIT",
  "peerDependencies": {
    "cordis": "^4.0.0",
    "react": ">=18"
  }
}
